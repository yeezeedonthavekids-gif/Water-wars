{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        "public": {
          ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()"
        },
        "private": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },
        "members": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "presence": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
          ".validate": "!newData.exists() || (newData.hasChildren(['online', 'at']) && newData.child('online').isBoolean() && newData.child('at').isNumber())",
          "online": { ".validate": true },
          "at": { ".validate": true },
          "$other": { ".validate": false }
        }
      }
    },
    "roomIndex": {
      ".indexOn": [".value"]
    }
  }
}
